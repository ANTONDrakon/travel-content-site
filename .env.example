PIXABAY_API_KEY=your_pixabay_api_key
DEEPSEEK_API_KEY=sk-your_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
TRAVELPAYOUTS_MARKER=your_marker_here
TRAVELPAYOUTS_API_TOKEN=your_token_here
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CX=your_google_custom_search_cx

# Booking.com Affiliate API (для легальных фото отелей)
BOOKING_COM_AID=397643
BOOKING_COM_SHARED_SECRET=your_shared_secret_here

SITE_URL=https://antondrakon.github.io/travel-content-site

# Analytics
ANALYTICS_ENABLED=true
YANDEX_METRIKA_ID=your_yandex_metrika_id
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Spam protection (reCAPTCHA v2)
# Get your keys at: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key  # Used by Formspree, not needed in .env

# Email newsletter (Brevo)
# 1. Create free account at https://www.brevo.com
# 2. Go to Contacts > Forms > Create a form
# 3. Copy the form URL and paste below
BREVO_FORM_URL=https://your-form-id.marketing-brevo.com
